# ============================================================
# BugBoard Backend — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# DO NOT commit .env to version control.
# ============================================================

# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="postgresql://bugboard_user:bugboard_pass@localhost:5432/bugboard_db"

# Directory for uploaded project archives
UPLOAD_DIR="./uploads"

# Allowed CORS origins (comma-separated for multiple)
CORS_ORIGINS="*"
